# Environment variables for the Payton Suite storefront scaffold

# Core site configuration
NEXT_PUBLIC_SITE_URL=https://paytonviolins.com

# Saleor (GraphQL) configuration
SALEOR_API_URL=https://<saleor-host>/graphql/
SALEOR_CHANNEL=default-channel
SALEOR_CHECKOUT_FLOW=single
# Optional: storefront token if you rely on app permissions
SALEOR_STOREFRONT_TOKEN=

# Wagtail (REST v2)
WAGTAIL_API_URL=https://<cms-host>/api/v2/pages/
WAGTAIL_SEARCH_URL=https://<cms-host>/api/search/
WAGTAIL_MEDIA_BASE=https://<cms-host>/media/

# Payments (Stripe)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# ERP integration (existing endpoints)
NEXT_PUBLIC_ERP_API=http://localhost:8000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Observability
SENTRY_DSN=